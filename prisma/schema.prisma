generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @db.VarChar(96)
  username String @unique @db.VarChar(255)
  password String @db.Text
  name     String @db.Text
  role     String @db.Text
  grade    String @default("") @db.Text
  section  String @default("") @db.Text
  period   String @default("") @db.Text
  schoolId          String    @default("") @map("school_id") @db.Text
  accountStatus     String    @default("active") @map("account_status") @db.VarChar(32)
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  email             String    @default("") @db.VarChar(255)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  avatarUrl         String    @default("") @map("avatar_url") @db.VarChar(2048)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")

  @@index([email])
  @@map("users")
}

model AccountToken {
  id        String    @id @db.VarChar(96)
  userId    String    @map("user_id") @db.VarChar(96)
  tokenType String    @map("token_type") @db.VarChar(32)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdBy String    @default("") @map("created_by") @db.VarChar(96)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, tokenType])
  @@index([expiresAt])
  @@map("account_tokens")
}

model AuthSession {
  id             String    @id @db.VarChar(96)
  userId         String    @map("user_id") @db.VarChar(96)
  impersonatorId String    @default("") @map("impersonator_id") @db.VarChar(96)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model School {
  id                   String @id @default(uuid()) @db.VarChar(96)
  name                 String @db.Text
  schoolId             String @default("") @map("school_id") @db.Text
  address              String @default("") @db.Text
  short                String @default("") @db.Text
  attendanceLockCutoff String @default("") @map("attendance_lock_cutoff") @db.VarChar(10)
  contactEmail         String @default("") @map("contact_email") @db.VarChar(255)
  contactPhone         String @default("") @map("contact_phone") @db.VarChar(64)
  division             String @default("") @db.VarChar(255)
  district             String @default("") @db.VarChar(255)
  principalName        String @default("") @map("principal_name") @db.VarChar(255)
  schoolYear           String @default("") @map("school_year") @db.VarChar(32)
  gradingPeriod        String @default("") @map("grading_period") @db.VarChar(64)
  archivedAt           DateTime? @map("archived_at")
  archivedBy           String @default("") @map("archived_by") @db.VarChar(96)
  archiveReason        String @default("") @map("archive_reason") @db.VarChar(1000)
  sardoConsecutiveAbsences Int @default(3) @map("sardo_consecutive_absences")
  sardoCumulativeAbsences  Int @default(5) @map("sardo_cumulative_absences")

  @@map("schools")
}

model SchoolArchiveUserStatus {
  userId      String   @id @map("user_id") @db.VarChar(96)
  schoolId    String   @map("school_id") @db.VarChar(96)
  priorStatus String   @map("prior_status") @db.VarChar(32)
  archivedAt  DateTime @default(now()) @map("archived_at")

  @@index([schoolId])
  @@map("school_archive_user_status")
}

model GradeLevel {
  id       String @id @default(uuid()) @db.VarChar(96)
  schoolId String @map("school_id") @db.VarChar(96)
  grade    String @db.Text
  sections String @default("[]") @db.Text
  sort     Int    @default(0)

  @@map("grade_levels")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  actorId        String   @default("") @map("actor_id") @db.Text
  actorName      String   @default("") @map("actor_name") @db.Text
  actorRole      String   @default("") @map("actor_role") @db.Text
  actorSchoolId  String   @default("") @map("actor_school_id") @db.Text
  action         String   @db.Text
  targetType     String   @default("") @map("target_type") @db.Text
  targetId       String   @default("") @map("target_id") @db.Text
  targetName     String   @default("") @map("target_name") @db.Text
  targetSchoolId String   @default("") @map("target_school_id") @db.Text
  detail         String   @default("") @db.Text

  @@map("audit_logs")
}

model Student {
  id       String @id @default(uuid()) @db.VarChar(96)
  name     String @db.Text
  grade    String @db.Text
  section  String @db.Text
  gender                  String   @default("") @db.Text
  schoolId                String   @default("") @map("school_id") @db.Text
  enrollmentStatus        String   @default("active") @map("enrollment_status") @db.VarChar(32)
  lrn                     String   @default("") @db.VarChar(32)
  birthDate               String   @default("") @map("birth_date") @db.VarChar(10)
  address                 String?  @db.Text
  guardianName            String   @default("") @map("guardian_name") @db.VarChar(255)
  guardianRelationship    String   @default("") @map("guardian_relationship") @db.VarChar(64)
  guardianContact         String   @default("") @map("guardian_contact") @db.VarChar(64)
  emergencyContactName    String   @default("") @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactNumber  String   @default("") @map("emergency_contact_number") @db.VarChar(64)
  consentDataSharing      Int      @default(1) @map("consent_data_sharing")
  consentMedicalEmergency Int      @default(1) @map("consent_medical_emergency")

  @@map("students")
}

model StudentIntervention {
  id                String   @id @default(uuid()) @db.VarChar(96)
  schoolId          String   @map("school_id") @db.VarChar(96)
  studentId         String   @map("student_id") @db.VarChar(96)
  concernType       String   @map("concern_type") @db.VarChar(64)
  assignedStaffId   String   @default("") @map("assigned_staff_id") @db.VarChar(96)
  assignedStaffName String   @default("") @map("assigned_staff_name") @db.VarChar(255)
  actionTaken       String   @map("action_taken") @db.Text
  followUpDate      String   @default("") @map("follow_up_date") @db.VarChar(10)
  resolutionStatus  String   @default("open") @map("resolution_status") @db.VarChar(32)
  notes             String?  @db.Text
  createdBy         String   @default("") @map("created_by") @db.VarChar(96)
  createdByName     String   @default("") @map("created_by_name") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@index([schoolId, studentId])
  @@map("student_interventions")
}

model StudentGuardianContact {
  id              String   @id @default(uuid()) @db.VarChar(96)
  schoolId        String   @map("school_id") @db.VarChar(96)
  studentId       String   @map("student_id") @db.VarChar(96)
  contactDate     String   @map("contact_date") @db.VarChar(10)
  contactMethod   String   @map("contact_method") @db.VarChar(64)
  guardianName    String   @default("") @map("guardian_name") @db.VarChar(255)
  guardianContact String   @default("") @map("guardian_contact") @db.VarChar(64)
  reason          String   @default("") @db.VarChar(255)
  outcome         String?  @db.Text
  staffId         String   @default("") @map("staff_id") @db.VarChar(96)
  staffName       String   @default("") @map("staff_name") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("student_guardian_contacts")
}

model StudentEnrollmentEvent {
  id              String   @id @default(uuid()) @db.VarChar(96)
  studentId       String   @map("student_id") @db.VarChar(96)
  schoolId        String   @map("school_id") @db.VarChar(96)
  eventType       String   @map("event_type") @db.VarChar(32)
  status          String   @db.VarChar(32)
  effectiveOn     String   @map("effective_on") @db.VarChar(10)
  grade           String   @default("") @db.VarChar(255)
  section         String   @default("") @db.VarChar(255)
  reason          String   @default("") @db.VarChar(1000)
  actorId         String   @default("") @map("actor_id") @db.VarChar(96)
  actorName       String   @default("") @map("actor_name") @db.VarChar(255)
  actorRole       String   @default("") @map("actor_role") @db.VarChar(32)
  transferGroupId String   @default("") @map("transfer_group_id") @db.VarChar(96)
  eventSequence   BigInt   @default(0) @map("event_sequence")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("student_enrollment_events")
}

model AttendanceRecord {
  id            String @id @default(uuid()) @db.VarChar(96)
  date          String @db.Text
  grade         String @db.Text
  section       String @db.Text
  adviser       String @default("") @db.Text
  createdBy     String @default("") @map("created_by") @db.Text
  createdByName String @default("") @map("created_by_name") @db.Text
  summaryData   String @default("{}") @map("summary_data") @db.Text
  schoolId      String @default("") @map("school_id") @db.Text
  locked        Int    @default(0)
  lockedAt      DateTime? @map("locked_at")
  lockedBy      String @default("") @map("locked_by") @db.Text
  reopenedAt    DateTime? @map("reopened_at")
  reopenedBy    String @default("") @map("reopened_by") @db.Text
  reopenReason  String @default("") @map("reopen_reason") @db.Text
  teacherNotes  String? @default("") @map("teacher_notes") @db.Text

  @@map("attendance_records")
}

model AttendanceCorrection {
  id        BigInt   @id @default(autoincrement())
  recordId  String   @map("record_id") @db.VarChar(96)
  studentId String   @default("") @map("student_id") @db.Text
  field     String   @db.Text
  oldValue  String   @default("") @map("old_value") @db.Text
  newValue  String   @default("") @map("new_value") @db.Text
  reason    String   @default("") @db.Text
  actorId   String   @default("") @map("actor_id") @db.Text
  actorName String   @default("") @map("actor_name") @db.Text
  actorRole String   @default("") @map("actor_role") @db.Text
  schoolId  String   @default("") @map("school_id") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("attendance_corrections")
}

model MonthlyRecord {
  id            String   @id @default(uuid()) @db.VarChar(96)
  month         Int
  year          Int
  grade         String   @db.Text
  section       String   @db.Text
  adviser       String   @default("") @db.Text
  schoolHead    String   @default("") @map("school_head") @db.Text
  createdBy     String   @default("") @map("created_by") @db.Text
  createdByName String   @default("") @map("created_by_name") @db.Text
  schoolId      String   @default("") @map("school_id") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  summaryData   String   @default("{}") @map("summary_data") @db.Text
  excludedDates   String   @default("[]") @map("excluded_dates") @db.Text
  includeSaturdays Boolean  @default(false) @map("include_saturdays")

  @@map("monthly_records")
}

model MonthlyEntry {
  id           Int    @id @default(autoincrement())
  recordId     String @map("record_id") @db.Text
  studentId    String @map("student_id") @db.Text
  studentName  String @map("student_name") @db.Text
  days         String @default("{}") @db.Text
  present      Int    @default(0)
  absent       Int    @default(0)
  tardy        Int    @default(0)
  remarks      String @default("") @db.Text
  lateEnrollee Int    @default(0) @map("late_enrollee")

  @@map("monthly_entries")
}

model Setting {
  key   String @id @db.VarChar(255)
  value String @default("") @db.Text

  @@map("settings")
}

model AttendanceEntry {
  id        Int    @id @default(autoincrement())
  recordId  String @map("record_id") @db.Text
  studentId String @map("student_id") @db.Text
  name      String @default("") @db.Text
  am1       String @default("") @db.Text
  am2       String @default("") @db.Text
  am3       String @default("") @db.Text
  am4       String @default("") @db.Text
  am5       String @default("") @db.Text
  am6       String @default("") @db.Text
  pm1       String @default("") @db.Text
  pm2       String @default("") @db.Text
  pm3       String @default("") @db.Text
  pm4       String @default("") @db.Text
  reason    String @default("") @db.Text
  excused   Int    @default(0)
  unexcused Int    @default(0)
  nls       Int    @default(0)

  @@map("attendance_entries")
}

model TeacherSchedule {
  id        Int    @id @default(autoincrement())
  teacherId String @map("teacher_id") @db.Text
  dayOfWeek Int    @default(0) @map("day_of_week")
  period    String @default("") @db.Text
  startTime String @default("") @map("start_time") @db.Text
  endTime   String @default("") @map("end_time") @db.Text
  subject   String @default("") @db.Text
  grade     String @default("") @db.Text
  section   String @default("") @db.Text
  schoolId  String @default("") @map("school_id") @db.Text

  @@map("teacher_schedules")
}

model CalendarEvent {
  id        Int    @id @default(autoincrement())
  title     String @default("") @db.Text
  type      String @default("") @db.Text
  eventDate String @default("") @map("event_date") @db.Text
  color     String @default("") @db.Text
  createdBy String @default("") @map("created_by") @db.Text
  schoolId  String @default("") @map("school_id") @db.Text

  @@map("calendar_events")
}

model QuarterlyEvent {
  id            Int    @id @default(autoincrement())
  eventName     String @default("") @map("event_name") @db.Text
  firstGrading  String @default("") @map("first_grading") @db.Text
  secondGrading String @default("") @map("second_grading") @db.Text
  thirdGrading  String @default("") @map("third_grading") @db.Text
  fourthGrading String @default("") @map("fourth_grading") @db.Text
  schoolId      String @default("") @map("school_id") @db.Text

  @@map("quarterly_events")
}

model License {
  id           String @id @default(uuid()) @db.VarChar(96)
  schoolId     String @default("") @map("school_id") @db.VarChar(96)
  licenseKey   String @unique @map("license_key") @db.VarChar(64)
  planTier     String @default("campus") @map("plan_tier") @db.VarChar(32)
  status       String @default("active") @db.VarChar(32)
  billingCycle String @default("annual") @map("billing_cycle") @db.VarChar(32)
  maxTeachers  Int    @default(50) @map("max_teachers")
  maxStudents  Int    @default(1500) @map("max_students")
  issuedAt     String @default("") @map("issued_at") @db.Text
  expiresAt    String @default("") @map("expires_at") @db.Text
  trialEndsAt  String @default("") @map("trial_ends_at") @db.Text
  features     String @default("{}") @db.Text
  notes        String @default("") @db.Text

  @@map("licenses")
}

model SubscriptionPlan {
  id                 String  @id @db.VarChar(64)
  tier               String  @unique @db.VarChar(32)
  name               String  @db.VarChar(128)
  tag                String  @default("") @db.VarChar(64)
  description        String  @default("") @db.Text
  priceMonthly       Int     @default(0) @map("price_monthly")
  priceAnnualMonthly Int     @default(0) @map("price_annual_monthly")
  billingAnnualTotal Int     @default(0) @map("billing_annual_total")
  billingMonths      Int?    @map("billing_months")
  currency           String  @default("PHP") @db.VarChar(10)
  trialDays          Int     @default(14) @map("trial_days")
  maxTeachers        Int     @default(1) @map("max_teachers")
  maxStudents        Int     @default(65) @map("max_students")
  isFeatured         Int     @default(0) @map("is_featured")
  badge              String  @default("") @db.VarChar(64)
  ctaText            String  @default("Inquire") @map("cta_text") @db.VarChar(64)
  ctaUrl             String  @default("") @map("cta_url") @db.VarChar(255)
  features           String  @default("[]") @db.Text
  modules            String  @default("{}") @db.Text
  sortOrder          Int     @default(0) @map("sort_order")

  @@map("subscription_plans")
}

model SubscriptionRequest {
  id                String   @id @default(uuid()) @db.VarChar(96)
  schoolId          String   @default("") @map("school_id") @db.VarChar(96)
  licenseId         String   @default("") @map("license_id") @db.VarChar(96)
  requestType       String   @default("") @map("request_type") @db.VarChar(32)
  planTier          String   @default("campus") @map("plan_tier") @db.VarChar(32)
  billingCycle      String   @default("annual") @map("billing_cycle") @db.VarChar(32)
  amount            Int      @default(0)
  paymentMethodId   String   @default("") @map("payment_method_id") @db.VarChar(96)
  paymentReference  String   @default("") @map("payment_reference") @db.VarChar(255)
  proofUrl          String   @default("") @map("proof_url") @db.Text
  status            String   @default("pending") @db.VarChar(32)
  requestedBy       String   @default("") @map("requested_by") @db.VarChar(96)
  reviewedBy        String   @default("") @map("reviewed_by") @db.VarChar(96)
  reviewedAt        String   @default("") @map("reviewed_at") @db.Text
  notes             String   @default("") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@map("subscription_requests")
}

model Inquiry {
  id           String   @id @default(uuid()) @db.VarChar(96)
  schoolId     String   @default("") @map("school_id") @db.VarChar(96)
  schoolName   String   @default("") @map("school_name") @db.Text
  userId       String   @default("") @map("user_id") @db.VarChar(96)
  userName     String   @default("") @map("user_name") @db.Text
  userEmail    String   @default("") @map("user_email") @db.VarChar(255)
  userRole     String   @default("") @map("user_role") @db.VarChar(32)
  category     String   @default("general") @db.VarChar(64)
  subject      String   @default("") @db.Text
  status       String   @default("open") @db.VarChar(32)
  userNotified Int      @default(0) @map("user_notified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  resolvedAt   String   @default("") @map("resolved_at") @db.Text
  resolvedBy   String   @default("") @map("resolved_by") @db.VarChar(96)

  @@map("inquiries")
}

model InquiryMessage {
  id         String   @id @default(uuid()) @db.VarChar(96)
  inquiryId  String   @map("inquiry_id") @db.VarChar(96)
  senderId   String   @default("") @map("sender_id") @db.VarChar(96)
  senderName String   @default("") @map("sender_name") @db.Text
  senderRole String   @default("") @map("sender_role") @db.VarChar(32)
  message    String   @default("") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("inquiry_messages")
}

model PaymentMethod {
  id            String   @id @default(uuid()) @db.VarChar(96)
  type          String   @default("bank_transfer") @db.VarChar(32)
  bankName      String   @default("") @map("bank_name") @db.VarChar(128)
  accountName   String   @default("") @map("account_name") @db.VarChar(255)
  accountNumber String   @default("") @map("account_number") @db.VarChar(128)
  qrImageUrl    String?  @map("qr_image_url") @db.LongText
  instructions  String   @default("") @db.Text
  isActive      Int      @default(1) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@map("payment_methods")
}

model SubscriptionStatusHistory {
  id         String   @id @default(uuid()) @db.VarChar(96)
  schoolId   String   @default("") @map("school_id") @db.VarChar(96)
  licenseId  String   @default("") @map("license_id") @db.VarChar(96)
  requestId  String   @default("") @map("request_id") @db.VarChar(96)
  fromStatus String   @default("") @map("from_status") @db.VarChar(32)
  toStatus   String   @default("") @map("to_status") @db.VarChar(32)
  actorId    String   @default("") @map("actor_id") @db.VarChar(96)
  actorName  String   @default("") @map("actor_name") @db.VarChar(255)
  actorRole  String   @default("") @map("actor_role") @db.VarChar(32)
  notes      String?  @db.Text
  metadata   String?  @db.LongText
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt], map: "idx_sub_history_school")
  @@index([requestId], map: "idx_sub_history_request")
  @@map("subscription_status_history")
}

model LicenseExpirationReminder {
  id                   String   @id @default(uuid()) @db.VarChar(96)
  licenseId            String   @map("license_id") @db.VarChar(96)
  schoolId             String   @default("") @map("school_id") @db.VarChar(96)
  reminderType         String   @map("reminder_type") @db.VarChar(32)
  targetExpirationDate String   @default("") @map("target_expiration_date") @db.VarChar(32)
  daysRemaining        Int      @default(0) @map("days_remaining")
  channel              String   @default("both") @db.VarChar(32)
  recipientsCount      Int      @default(0) @map("recipients_count")
  recipientsData       String?  @map("recipients_data") @db.LongText
  status               String   @default("sent") @db.VarChar(32)
  notes                String?  @db.Text
  sentAt               DateTime @default(now()) @map("sent_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([licenseId, reminderType, targetExpirationDate], map: "uq_license_reminder")
  @@index([schoolId, sentAt], map: "idx_reminders_school_sent")
  @@index([licenseId], map: "idx_reminders_license")
  @@map("license_expiration_reminders")
}
