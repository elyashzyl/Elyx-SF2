# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# Never copy production credentials into this file. Use the hosting platform's secret manager.
# Generate replacement values with: npm run secrets:generate
# For local SQLite (default when DATABASE_URL is unset):
DB_PATH=attendance.db
ALLOW_PERSISTED_SQLITE=1

# For MySQL / MariaDB (production or local MySQL):
# DATABASE_URL=mysql://user:password@localhost:3306/elytrack
# DB_USERNAME=elytrack_app
# DB_PASSWORD=replace-in-secret-manager
# MYSQL_POOL_MAX=10
# MYSQL_SSL=1
# MYSQL_SSL_VERIFY=0
# REQUIRE_MYSQL=1
