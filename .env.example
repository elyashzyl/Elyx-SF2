# MySQL connection used by the app (required for production).
# When unset, the app falls back to SQLite (attendance.db) for local dev.
DATABASE_URL=mysql://elyx:elyxsecret@localhost:3306/elyx

# Docker Compose MySQL service credentials (used only by compose).
MYSQL_DATABASE=elyx
MYSQL_USER=elyx
MYSQL_PASSWORD=elyxsecret

# Optional: pool size
# MYSQL_POOL_MAX=10

# Managed MySQL providers (Aiven, DigitalOcean, etc.) usually require TLS.
# The app detects ssl=../sslmode=../ssl-mode= in DATABASE_URL or MYSQL_SSL=1 and
# auto-retries with TLS (rejectUnauthorized=false) if the server demands it.
# MYSQL_SSL=1

# Production safety: refuse to start on the ephemeral SQLite fallback, so a
# misconfigured deploy fails loudly instead of silently resetting on redeploy.
# (Already enforced automatically when NODE_ENV=production.)
# REQUIRE_MYSQL=1

# Local dev only: path to the SQLite file used when DATABASE_URL is not set.
# DB_PATH=attendance.db