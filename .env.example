# Postgres connection used by the app (required for production).
# When unset, the app falls back to SQLite (attendance.db) for local dev.
DATABASE_URL=postgres://elyx:elyxsecret@localhost:5432/elyx

# Docker Compose Postgres service credentials (used only by compose).
POSTGRES_DB=elyx
POSTGRES_USER=elyx
POSTGRES_PASSWORD=elyxsecret

# Optional: pool size
# PG_POOL_MAX=10

# Local dev only: path to the SQLite file used when DATABASE_URL is not set.
# DB_PATH=attendance.db