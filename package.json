{
  "name": "elytrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch routes --watch db.js --watch server.js --watch package.json node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:fresh": "node scripts/migrate.mjs --fresh",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "node scripts/migrate.mjs && node scripts/seed.mjs",
    "db:reset": "node scripts/reset-sqlite.mjs",
    "db:export-mysql": "node scripts/migrate-sqlite-to-mysql.mjs",
    "db:backup": "node scripts/backup.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node scripts/seed.mjs"
  },
  "prisma": {
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "mysql2": "^3.24.4",
    "pinia": "^3.0.4",
    "sql.js": "^1.11.0",
    "uuid": "^10.0.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^10.0.3",
    "nodemon": "^3.0.3",
    "prisma": "6.4.1",
    "vite": "^8.0.12"
  }
}
